# Download only via tools/bootstrap_dependencies.py; CMake never uses the network.
set(NETARENA_DEPS_DIR "${PROJECT_SOURCE_DIR}/.deps" CACHE PATH "Verified local dependencies")
function(netarena_require path)
    if(NOT EXISTS "${path}")
        message(FATAL_ERROR "Missing ${path}. Run: python3 tools/bootstrap_dependencies.py --godot")
    endif()
endfunction()
netarena_require("${NETARENA_DEPS_DIR}/json/include/nlohmann/json.hpp")
netarena_require("${NETARENA_DEPS_DIR}/enet-1.3.18/CMakeLists.txt")
add_library(netarena_json INTERFACE)
target_include_directories(netarena_json SYSTEM INTERFACE "${NETARENA_DEPS_DIR}/json/include")
add_subdirectory("${NETARENA_DEPS_DIR}/enet-1.3.18" "${CMAKE_BINARY_DIR}/third_party/enet" EXCLUDE_FROM_ALL)
set_target_properties(enet PROPERTIES POSITION_INDEPENDENT_CODE ON)
target_include_directories(enet SYSTEM PUBLIC "${NETARENA_DEPS_DIR}/enet-1.3.18/include")
if(WIN32)
    target_link_libraries(enet PUBLIC winmm ws2_32)
endif()
